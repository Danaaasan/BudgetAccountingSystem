@model Transaction

@{
    ViewData["Title"] = "Редактирование проводки";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4" style="max-width: 600px;">
        <div class="card-body">
            <h2 class="mb-4">Редактирование проводки</h2>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="AccountId" class="form-label">ID счёта</label>
                    <input asp-for="AccountId" class="form-control" type="number" />
                </div>
                <div class="mb-3">
                    <label asp-for="Type" class="form-label">Тип операции</label>
                    <select asp-for="Type" class="form-select">
                        <option value="Начисление">Начисление</option>
                        <option value="Списание">Списание</option>
                        <option value="Перевод">Перевод</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="DebitAccount" class="form-label">Дебет</label>
                    <input asp-for="DebitAccount" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="CreditAccount" class="form-label">Кредит</label>
                    <input asp-for="CreditAccount" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Amount" class="form-label">Сумма</label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Назначение</label>
                    <input asp-for="Description" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-action="Index" class="btn btn-secondary">Назад</a>
            </form>
        </div>
    </div>
</div>