@model Employee

@{
    ViewData["Title"] = "Добавление";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4" style="max-width: 600px;">
        <div class="card-body">
            <h2 class="mb-4">Добавление сотрудника</h2>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">ФИО</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Position" class="form-label">Должность</label>
                    <input asp-for="Position" class="form-control" />
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Department" class="form-label">Отдел</label>
                    <input asp-for="Department" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Salary" class="form-label">Оклад</label>
                    <input asp-for="Salary" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Salary" class="text-danger"></span>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Активен</label>
                </div>
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-action="Index" class="btn btn-secondary">Назад</a>
            </form>
        </div>
    </div>
</div>