@model List<Employee>

@{
    ViewData["Title"] = "Сотрудники";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Сотрудники</h1>
            <p class="text-muted">Всего: @Model.Count</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Добавить
        </a>
    </div>

    <div class="row g-4">
        @foreach (var emp in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @emp.Id</span>
                        @if (emp.IsActive)
                        {
                            <span class="badge bg-success mb-2">Активен</span>
                        }
                        else
                        {
                            <span class="badge bg-danger mb-2">Неактивен</span>
                        }
                        <h5 class="card-title">@emp.FullName</h5>
                        <p class="text-muted mb-1">@emp.Position</p>
                        <p class="text-muted mb-2">Отдел: @emp.Department</p>
                        <p class="fs-4 fw-bold">@emp.Salary BYN</p>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@emp.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-outline-secondary btn-sm">Ред.</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>